rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with a job's id can watch it; only the showcase (demo == true) can be listed.
    // Only the API and the worker (service account, server SDK) write.
    match /jobs/{job} {
      allow get: if true;
      allow list: if resource.data.demo == true;
      allow write: if false;
    }
    // Ownership hashes and resumable workspace pointers are server-only.
    match /quotas/{document=**} { allow read, write: if false; }
    match /job_access/{document=**} { allow read, write: if false; }
    match /jobs/{job}/{document=**} { allow read: if true; allow write: if false; }
  }
}
