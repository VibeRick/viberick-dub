rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jobs, their live events and line results are public to read (the demo UI).
    // Only the API and worker (service account, server SDK) write.
    match /jobs/{job}/{document=**} { allow read: if true; allow write: if false; }
    match /jobs/{job} { allow read: if true; allow write: if false; }
  }
}
